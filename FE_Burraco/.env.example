# ─── Frontend Burraco (Vercel) ────────────────────────────────────────────
# URL del backend WebSocket (Render). In locale punta al BE su localhost.
# In produzione: wss://<tuo-servizio>.onrender.com  (in prod è AMMESSO SOLO wss://)
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# URL HTTP del backend per gli endpoint /auth/* (register/login/guest/logout/me).
# Stesso host del WS (Express e ws condividono lo stesso http.Server su Render).
# In locale http://localhost:8080; in produzione DEVE essere https://<...>.onrender.com
# (in prod è AMMESSO SOLO https://, specchio del vincolo wss:// del WebSocket).
NEXT_PUBLIC_API_URL=http://localhost:8080

# ─── SEC-A6 — Content-Security-Policy (build-time) ────────────────────────
# Queste due variabili alimentano ANCHE il `connect-src` della CSP definita in
# next.config.mjs. ATTENZIONE: gli header di Next sono risolti a BUILD TIME, non a
# runtime. Su Vercel devono quindi essere presenti come env di BUILD, altrimenti la
# CSP consentirà solo 'self' e il browser BLOCCHERÀ le chiamate HTTP/WS al backend.
# Da ciascun URL si ricava l'origine (schema://host:porta) e la si aggiunge a
# connect-src (es. https://<svc>.onrender.com e wss://<svc>.onrender.com).

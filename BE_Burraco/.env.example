# ─── Backend Burraco (Render) ─────────────────────────────────────────────
# Porta del web service (Render la inietta automaticamente; in locale default 8080)
PORT=8080

# Connessione a Neon PostgreSQL — usa l'endpoint POOLED (…-pooler.neon.tech).
# Se NON impostata, il server gira comunque: la persistenza (checkpoint/eventi)
# viene disattivata e il gioco resta pienamente funzionante in RAM.
# SEC-06: usa `sslmode=verify-full` (coerente con rejectUnauthorized:true in
# db/client.ts): il certificato del server viene verificato, nessun downgrade TLS.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=verify-full

# Origini consentite — STRATO (a) ESATTO della policy origin (CORS HTTP + handshake WS),
# separate da virgola. In locale il default consente tutto ("*"); in produzione va
# usato per domini CUSTOM o casi speciali (es. https://burraco.tuodominio.com).
# NON serve elencare qui gli URL *.vercel.app del progetto: li riconosce lo strato (b)
# a pattern (vedi sotto). In produzione "*" o lista assente = fail-closed per questo
# strato (lo strato pattern resta comunque attivo). MAI "*" in produzione.
ALLOWED_ORIGINS=

# STRATO (b) PATTERN Vercel (SEMPRE attivo, non richiede ALLOWED_ORIGINS).
# Ammette gli URL che Vercel genera per il progetto/team indicati:
#   https://<VERCEL_PROJECT>.vercel.app                              (produzione)
#   https://<VERCEL_PROJECT>-git-<branch>-<VERCEL_TEAM_SLUG>.vercel.app  (branch)
#   https://<VERCEL_PROJECT>-<hash>-<VERCEL_TEAM_SLUG>.vercel.app        (preview)
# La regex è ANCORATA (^...$) e lo schema è obbligatoriamente https: nessun suffisso
# o prefisso malevolo con "vercel.app" viene ammesso. Default sotto; sovrascrivi su
# Render se il progetto/team Vercel cambiano.
VERCEL_PROJECT=burraco
VERCEL_TEAM_SLUG=groupgames

# Finestra di grazia (ms) entro cui un giocatore disconnesso può rientrare nella
# room. Scaduta con l'avversario ancora presente, la partita è ANNULLATA per
# abbandono (room_closed{abandoned}, nessun vincitore).
RECONNECT_GRACE_MS=180000

# NEW-1: TTL (ms) entro cui il token PRECEDENTE resta accettato dopo la rotazione
# alla riconnessione (copre la perdita del frame room_joined). Breve: il vecchio
# token muore alla prima azione valida sul nuovo socket o allo scadere di questo TTL.
TOKEN_ROTATION_TTL_MS=15000

# Timeout di inattività del turno (ms). DEFINITO ma NON enforced in v1 (hook nel codice).
TURN_TIMEOUT_MS=90000

# ─── Auth (Macro-ciclo 1) ─────────────────────────────────────────────────
# SEC-08: se true, join_room richiede un authToken VALIDO (niente ingresso col
# solo codice tavolo). Default: ON in produzione (NODE_ENV=production), OFF in
# sviluppo. Override esplicito qui ("true"/"false").
# REQUIRE_AUTH_JOIN=true

# TTL (ms) della sessione auth (token opaco in tabella `sessions`). Default 7 giorni.
SESSION_TTL_MS=604800000

# ─── Diagnostica (Macro-ciclo 2 — igiene) ─────────────────────────────────
# DIAG_JOIN: se "true" riattiva i log diagnostici [join] della Room (solo
# booleani/conteggi, MAI segreti). Default OFF. Usare solo per diagnosi mirate.
# DIAG_JOIN=true

# ─── Email Brevo (Fase 1 — SOLO backend) ──────────────────────────────────
# La API key NON può stare sul FE ("use client" + CSP `connect-src`): il browser
# non può contattare api.brevo.com, quindi l'unica via è il BE come proxy. Nessuna
# NEXT_PUBLIC_ associata a Brevo. VALORI FITTIZI qui (file versionato/pubblico):
# la chiave reale va SOLO nelle env di Render.
BREVO_API_KEY=xkeysib-xxxxxxxx-fittizia
BREVO_SENDER_EMAIL=no-reply@circolonettuno.example
BREVO_SENDER_NAME=Circolo Nettuno
# Destinatario dei messaggi del form contatti (§2).
CONTACT_TO_EMAIL=contatti@circolonettuno.example
# Interruttore d'invio: OFF finché non è "true" (in test/branch resta spento, i
# messaggi si salvano comunque sul DB — l'email è un di più, §2.1).
BREVO_ENABLED=false

# ─── Log di Render (Fase 5.4 — Blocco C, SOLO backend) ─────────────────────
# Il BE fa da proxy verso l'API di Render per mostrare i log nell'area webmaster;
# la chiave non raggiunge mai il FE. Valori fittizi qui.
RENDER_API_KEY=rnd_xxxxxxxx-fittizia
RENDER_SERVICE_ID=srv-xxxxxxxxxxxxxxxx

# ─── Privacy dati a riposo (Fase 2 — form contatti) ────────────────────────
# Sale per l'hash NON reversibile dell'IP di chi usa il form (`sha256(ip+salt)`):
# nel DB non finisce mai l'IP in chiaro. Imposta un valore casuale lungo in prod.
IP_HASH_SALT=cambia-questo-in-produzione-con-una-stringa-casuale-lunga
